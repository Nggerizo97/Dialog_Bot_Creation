# AWS Emulator local environment variables (default port 9297)
# In PowerShell, dot-source ./infra/local/use-aws-emulator.ps1
# In Bash/Zsh, source ./infra/local/use-aws-emulator.sh
AWS_ENDPOINT_URL=https://127.0.0.1:9297
AWS_SHARED_CREDENTIALS_FILE=~/.aws/emulator/9297/emulator_credentials
AWS_CONFIG_FILE=~/.aws/emulator/9297/config
AWS_CA_BUNDLE=~/.aws/emulator/9297/ca.pem
SSL_CERT_FILE=~/.aws/emulator/9297/ca.pem
NODE_EXTRA_CA_CERTS=~/.aws/emulator/9297/ca.pem
AWS_EC2_METADATA_DISABLED=true
AWS_DISABLE_HOST_PREFIX_INJECTION=true
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
EMULATOR_TELEMETRY=off

# Bot_Dialog_Generator AWS resource names
S3_DEFINITIONS_BUCKET=bot-dialog-generator-definitions
S3_MEDIA_BUCKET=bot-dialog-generator-media
S3_CAMPAIGNS_BUCKET=bot-dialog-generator-campaigns
S3_DEBUGGER_BUCKET=bot-dialog-generator-debugger
KMS_SIGNING_KEY_ID=alias/bot-dialog-generator-signing
SQS_EVENTS_QUEUE=bot-dialog-generator-events
SQS_CAMPAIGNS_QUEUE=bot-dialog-generator-campaigns
