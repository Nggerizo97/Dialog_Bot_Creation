# Copy to .env.local (ignored by git) to sign in with Microsoft Entra ID.
# Leave these unset to keep the development sign-in with demo users.
# Setup guide: docs/entra-setup.md
VITE_OIDC_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
VITE_OIDC_CLIENT_ID=<client-id>
VITE_OIDC_SCOPE=openid profile offline_access api://<client-id>/access_as_user
# For Amazon Cognito managed login instead (docs/cognito-setup.md):
#   VITE_OIDC_AUTHORITY=https://cognito-idp.<region>.amazonaws.com/<pool-id>
#   VITE_OIDC_SCOPE=openid email profile
#   VITE_OIDC_PROVIDER_NAME=<your company>
# For local Cognito in the AWS Emulator, run `go run ./tools/cognito-local -write-env`
# and `npm run dev:cognito` instead; it writes .env.cognito.local.

# Studio API address (default http://localhost:8080)
# VITE_STUDIO_API_URL=http://localhost:8080

# Usage statistics (optional). When set, a privacy banner asks each person to opt in;
# nothing is sent to the analytics service before they do.
# VITE_ANALYTICS_URL=http://localhost:8084

# Business and legal contact, printed in the footer and on #/legal/business.
# Fill them from docs/legal/BUSINESS_INFORMATION.md. Unset values show their placeholder.
# VITE_LEGAL_ENTITY_NAME=
# VITE_LEGAL_TAX_ID=
# VITE_LEGAL_ADDRESS=
# VITE_LEGAL_SUPPORT_EMAIL=
# VITE_LEGAL_PRIVACY_EMAIL=
# VITE_LEGAL_DPO_CONTACT=
# Version of the Terms of Use and Privacy Policy that people accept at sign-in.
# VITE_LEGAL_TERMS_VERSION=2026-11
