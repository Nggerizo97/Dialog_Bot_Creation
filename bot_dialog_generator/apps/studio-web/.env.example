# Copy to .env.local (ignored by git) to sign in with Microsoft Entra ID.
# Leave these unset to keep the development sign-in with demo users.
# Setup guide: docs/entra-setup.md
VITE_OIDC_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
VITE_OIDC_CLIENT_ID=<client-id>
VITE_OIDC_SCOPE=openid profile offline_access api://<client-id>/access_as_user

# Studio API address (default http://localhost:8080)
# VITE_STUDIO_API_URL=http://localhost:8080
